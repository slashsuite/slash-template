{
  "name": "@hackcove/slashproduct",
  "version": "0.1.0",
  "description": "The SlashProduct command line.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slashsuite/slashproduct.git",
    "directory": "packages/cli"
  },
  "bin": {
    "slashproduct": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "cp ../../LICENSE ../../NOTICE . && bun build src/index.ts --outfile dist/index.js --target bun"
  },
  "devDependencies": {
    "@hackcove/slashproduct-engine": "workspace:*",
    "@types/bun": "1.4.5",
    "vitest": "5.1.1"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
